@model HopTacDoanhNghiep.ViewModels.Account.DangKyDoanhNghiepVM
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Đăng ký doanh nghiệp";
    var selectedDonVis = Model?.SelectedDonVis ?? new List<HopTacDoanhNghiep.ViewModels.DonVi.DonViVM>();
}

<div class="breadcrumb-wrap">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="/">Trang chủ</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Đăng ký doanh nghiệp</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <div class="contact-form">
        <div class="row">
            <div class="mb-4">
                <h1 class="title"><i class="fa-solid fa-building"></i> Đăng ký doanh nghiệp</h1>
                <p class="subtitle">Điền thông tin doanh nghiệp để chúng tôi liên hệ và duyệt hợp tác.</p>
            </div>

            <div class="col-12 col-lg-6 mb-4 mb-lg-0">
                <form asp-controller="Account" asp-action="DangKyDoanhNghiep" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <h4>Thông tin người đại diện</h4>
                    <div class="form-group mb-3">
                        <label asp-for="HoTenNguoiDaiDien"><strong><i class="fa-solid fa-user"></i> Họ và tên</strong> <span class="text-danger">(*)</span></label>
                        <input asp-for="HoTenNguoiDaiDien" class="form-control" />
                        <span asp-validation-for="HoTenNguoiDaiDien" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="SoDienThoaiNguoiDaiDien"><strong><i class="fa-solid fa-phone"></i> Số điện thoại</strong> <span class="text-danger">(*)</span></label>
                        <input asp-for="SoDienThoaiNguoiDaiDien" class="form-control" />
                        <span asp-validation-for="SoDienThoaiNguoiDaiDien" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="EmailNguoiDaiDien"><strong><i class="fa-solid fa-envelope"></i> Email người đại diện</strong> <span class="text-danger">(*)</span></label>
                        <input asp-for="EmailNguoiDaiDien" class="form-control" />
                        <span asp-validation-for="EmailNguoiDaiDien" class="text-danger"></span>
                    </div>

                    <h4>Thông tin doanh nghiệp</h4>
                    <div class="form-group mb-3">
                        <label asp-for="TenHienThiDoanhNghiep"><strong><i class="fa-solid fa-building"></i> Tên hiển thị</strong> <span class="text-danger">(*)</span></label>
                        <input asp-for="TenHienThiDoanhNghiep" class="form-control" />
                        <span asp-validation-for="TenHienThiDoanhNghiep" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="TenPhapLyDoanhNghiep"><strong><i class="fa-solid fa-gavel"></i> Tên pháp lý</strong> <span class="text-danger">(*)</span></label>
                        <input asp-for="TenPhapLyDoanhNghiep" class="form-control" />
                        <span asp-validation-for="TenPhapLyDoanhNghiep" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="MaSoThue"><strong><i class="fa-solid fa-id-card"></i> Mã số thuế</strong> <span class="text-danger">(*)</span></label>
                        <input asp-for="MaSoThue" class="form-control" />
                        <span asp-validation-for="MaSoThue" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Website"><strong><i class="fa-solid fa-globe"></i> Website</strong></label>
                        <input asp-for="Website" class="form-control" />
                        <span asp-validation-for="Website" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Hotline"><strong><i class="fa-solid fa-phone"></i> Hotline</strong> <span class="text-danger">(*)</span></label>
                        <input asp-for="Hotline" class="form-control" />
                        <span asp-validation-for="Hotline" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="EmailCongTy"><strong><i class="fa-solid fa-envelope"></i> Email công ty</strong> <span class="text-danger">(*)</span></label>
                        <input asp-for="EmailCongTy" class="form-control" />
                        <span asp-validation-for="EmailCongTy" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="NoiDungHopTac"><strong><i class="fa-solid fa-comment"></i> Nội dung hợp tác</strong> <span class="text-danger">(*)</span></label>
                        <textarea asp-for="NoiDungHopTac" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="NoiDungHopTac" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="SelectedDonViIds"><strong><i class="fa-solid fa-users"></i> Đơn vị nhận hợp tác</strong> <span class="text-danger">(*)</span></label>
                        <select asp-for="SelectedDonViIds" class="form-select" multiple="multiple" data-placeholder="Chọn một hoặc nhiều đơn vị nhận hợp tác">
                            @foreach (var donVi in selectedDonVis)
                            {
                                <option value="@donVi.MaDV" selected="selected">@donVi.TenDV</option>
                            }
                        </select>
                        <span asp-validation-for="SelectedDonViIds" class="text-danger"></span>
                    </div>

                    <div>
                        <button type="submit" class="btn btn-primary">Đăng ký</button>
                    </div>
                </form>
            </div>

            <div class="col-12 col-lg-6">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3469.4462524316514!2d108.20616247460016!3d16.0726022393487!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3142184930c87765%3A0xf27e1b78c01fbebe!2zMTM2IFRy4bqnbiBDYW8gVsOibiwgWHXDom4gSMOgLCBUaGFuaCBLaMOqLCDEkMOgIE7hurVuZyA1NTAwMDAsIFZp4buHdCBOYW0!5e1!3m2!1svi!2s!4v1771853560296!5m2!1svi!2s" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="/css/guest/contact_page.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="/js/guest/DangKyDoanhNghiep/DangKyDoanhNghiep.js"></script>
}
