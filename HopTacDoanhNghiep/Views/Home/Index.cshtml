@model HopTacDoanhNghiep.ViewModels.Home.HomeVM

@{
    ViewData["Title"] = "Trang chủ";
    ViewData["OgTitle"] = "Hệ thống Hợp tác Doanh nghiệp - Trường Đại học Công nghệ Kỹ thuật - Đại học Đà Nẵng";
    ViewData["OgDescription"] = "Hệ thống Hợp tác Doanh nghiệp - Trường Đại học Công nghệ Kỹ thuật - Đại học Đà Nẵng";
}

<section class="p-0">
    <h1 class="sr-only">
        Hệ thống Hợp tác Doanh nghiệp - Trường Đại học Công nghệ Kỹ thuật - Đại học Đà Nẵng
    </h1>
    <div class="container-fluid">
        <div class="swiper banner-slider">
            <div class="swiper-wrapper">
                <!-- Slide 1 -->
                <div class="swiper-slide">
                    <figure>
                        <img src="/image/banner/banner_01.png" alt="Giới thiệu website Hợp tác doanh nghiệp" loading="lazy" />
                        <figcaption class="sr-only">Banner 1: Giới thiệu website Hợp tác doanh nghiệp</figcaption>
                    </figure>
                </div>
                <!-- Slide 2 -->
                <div class="swiper-slide">
                    <figure>
                        <img src="/image/banner/banner_02.png" alt="Ngày hội tuyển dụng tại UTE" loading="lazy" />
                        <figcaption class="sr-only">Banner 2: Ngày hội tuyển dụng</figcaption>
                    </figure>
                </div>
            </div>
            <!-- Pagination -->
            <div class="swiper-pagination"></div>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-8 mb-4 mb-lg-0">
                <h2 class="section-header w-100 mb-3"><a href="/thong-tin/tin-tuc"><i class="fa-solid fa-newspaper me-2"></i> Tin tức</h2>
                <div class="row">
                        <div class="col-12 col-lg-6 mb-3 mb-lg-0">
                            @if (Model?.TinTucs != null && Model.TinTucs.Any())
                            {
                                var latest = Model.TinTucs.First();
                            <div class="lastest-news">
                                <div class="thumbnail mb-2">
                                    <img src="@(string.IsNullOrEmpty(latest.AnhMinhHoa) ? "/image/layout/default_noti_thumbnail.jpg" : latest.AnhMinhHoa)" class="w-100" alt="thumbnail" loading="lazy">
                                </div>
                                <div class="content">
                                    <div class="title mb-2">
                                        <a href="/thong-tin/tin-tuc/@(latest.Slug ?? "")">@latest.TieuDe</a>
                                    </div>
                                    <div class="meta">
                                        <div class="meta-item"><i class="fa-solid fa-calendar"></i> @(latest.CreatedAt?.ToString("dd/MM/yyyy"))</div>
                                        <div class="meta-item highlight"><i class="fa-solid fa-fire"></i> Mới nhất</div>
                                    </div>
                                </div>
                            </div>
                            }
                            else
                            {
                            <div class="lastest-news">
                                <div class="thumbnail mb-2">
                                    <img src="/image/layout/default_noti_thumbnail.jpg" class="w-100" alt="thumbnail" loading="lazy">
                                </div>
                                <div class="content">
                                    <div class="title mb-2">
                                        <a href="#">Chưa có tin tức</a>
                                    </div>
                                </div>
                            </div>
                            }
                        </div>
                    <div class="col-12 col-lg-6"> 
                        <div class="list-news">
                            @if (Model?.TinTucs != null && Model.TinTucs.Count > 1)
                            {
                                foreach (var item in Model.TinTucs.Skip(1).Take(5))
                                {
                                    <div class="news">
                                        <div class="row">
                                            <div class="col-4">
                                                <div class="thumbnail">
                                                    <img src="@(string.IsNullOrEmpty(item.AnhMinhHoa) ? "/image/layout/default_noti_thumbnail.jpg" : item.AnhMinhHoa)" class="w-100" alt="thumbnail" loading="lazy">
                                                </div>
                                            </div>
                                            <div class="col-8">
                                                <div class="content">
                                                    <div class="title">
                                                        <a href="/thong-tin/tin-tuc/@(item.Slug ?? "")">@item.TieuDe</a>
                                                    </div>

                                                    <div class="meta">
                                                        <i class="fa-solid fa-calendar"></i> @(item.CreatedAt?.ToString("dd/MM/yyyy"))
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="news">Chưa có tin tức khác</div>
                            }
                        </div>
                    </div>
                </div>               
            </div>
            <div class="col-12 col-lg-4">
                <h2 class="section-header w-100 mb-3"><a href="/thong-tin/thong-bao"><i class="fa-solid fa-bell me-2"></i> Thông báo</a></h2>
                <div class="list-notis">
                    @if (Model?.ThongBaos != null && Model.ThongBaos.Any())
                    {
                        foreach (var noti in Model.ThongBaos.Take(5))
                        {
                            <div class="noti">
                                <div class="row">
                                    <div class="col-4">
                                        <div class="thumbnail">
                                            <img src="@(string.IsNullOrEmpty(noti.AnhMinhHoa) ? "/image/layout/default_noti_thumbnail.jpg" : noti.AnhMinhHoa)" class="w-100" alt="thumbnail" loading="lazy">
                                        </div>
                                    </div>
                                    <div class="col-8">
                                        <div class="content">
                                            <div class="title">
                                                <a href="/thong-tin/thong-bao/@(noti.Slug ?? "")">@noti.TieuDe</a>
                                            </div>
                                            <div class="meta">
                                                <i class="fa-solid fa-calendar"></i> @(noti.CreatedAt?.ToString("dd/MM/yyyy"))
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="noti">Chưa có thông báo</div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="building-bg">
    <div class="container">
        <h2 class="section-header header-light w-100 mb-3"><a href="/viec-lam-tuyen-dung"><i class="fa-solid fa-globe me-2"></i> Việc làm - Tuyển dụng</a></h2>
        <div class="list-jobs mb-4">
            @if (Model?.ViecLams != null && Model.ViecLams.Any())
            {
                foreach (var vl in Model.ViecLams.Take(6))
                {
                    <div class="job">
                        <div class="thumbnail">
                            <img src="@(string.IsNullOrEmpty(vl.DoanhNghiepLogo) ? "/image/layout/company_logo.png" : vl.DoanhNghiepLogo)" alt="logo công ty" loading="lazy">
                        </div>
                        <div class="content">
                            <div class="title mb-2"><a href="/viec-lam-tuyen-dung/@(vl.Slug ?? vl.Id.ToString())">@vl.TieuDe</a></div>
                            <div class="summary mb-2">
                                @Html.Raw(vl.MoTa)
                            </div>
                            <div class="meta">
                                <div class="meta-item"><i class="fa-solid fa-map-pin"></i> @(vl.DiaDiem ?? "")</div>
                                <div class="meta-item"><i class="fa-solid fa-layer-group"></i> @(vl.LinhVuc ?? "")</div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div>Chưa có việc làm</div>
            }
        </div>
        <div class="text-center">
            <a href="/viec-lam-tuyen-dung" class="btn btn-more">Xem tất cả <i class="fa-solid fa-circle-chevron-right ms-2"></i></a>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <h2 class="section-header w-100 mb-3"><a href="/bai-viet"><i class="fa-solid fa-earth-americas me-2"></i> Bài viết</a></h2>
        <div class="swiper posts-slider">
            <div class="swiper-wrapper">
            @* Generate remaining 12 posts with swiper-slide wrapper *@
            @if (Model?.BaiViets != null && Model.BaiViets.Any())
            {
                foreach (var post in Model.BaiViets.Take(12))
                {
                    <div class="swiper-slide">
                        <div class="post">
                            <div class="thumbnail mb-3">
                                    <img src="@(string.IsNullOrEmpty(post.AnhMinhHoa) ? "/image/layout/default_noti_thumbnail.jpg" : post.AnhMinhHoa)" alt="ảnh thumbnail" loading="lazy">
                            </div>
                            <div class="content">
                                <div class="meta mb-2">
                                    <div class="meta-item"><i class="fa-solid fa-calendar"></i> @(post.CreatedAt?.ToString("dd/MM/yyyy"))</div>
                                    <div class="meta-item"><i class="fa-solid fa-list"></i> @(post.DanhMuc ?? "")</div>
                                </div>
                                <div class="title">
                                    <a href="/bai-viet/@(post.Slug ?? "")">@post.TieuDe</a>
                                </div>
                                <div class="summary">
                                    @Html.Raw(post.NoiDung)
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="swiper-slide">
                    <div class="post">Chưa có bài viết</div>
                </div>
            }
            </div>
            
            <!-- Pagination -->
            <div class="swiper-pagination"></div>
        </div>
    </div>
</section>