@model HopTacDoanhNghiep.ViewModels.Common.PageResult<HopTacDoanhNghiep.ViewModels.BaiViet.BaiVietVM>

@{
    var data = Model.Records;
    ViewData["Title"] = "Hợp tác doanh nghiệp";
    ViewData["OgType"] = "article";
    ViewData["OgTitle"] = "Hợp tác doanh nghiệp";
    ViewData["OgDescription"] =
        "Hợp tác doanh nghiệp Hệ thống Hợp tác Doanh nghiệp – Trường Đại học Công nghệ Kỹ thuật, Đại học Đà Nẵng";
    ViewData["OgUrl"] = "/thong-tin/hop-tac-doanh-nghiep";
}
<div class="breadcrumb-wrap mb-4">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="/">
                        Trang chủ
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="/thong-tin">
                        Thông tin
                    </a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Hợp tác doanh nghiệp</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container mb-4">

    <div class="row">
        <div class="col-12 col-xl-9">
            <h1 class="page-title">Hợp tác doanh nghiệp</h1>
            <hr>
            
            @await Html.PartialAsync("_Search")
            
            <div class="list-post mb-4">
                @if (data != null && data.Any())
                {
                    foreach (var post in data)
                    {
                        <article class="post">
                            <div class="row">
                                <div class="col-4">
                                    <div class="thumbnail-wrapper">
                                        <img src="@(!string.IsNullOrWhiteSpace(post.AnhMinhHoa) ? post.AnhMinhHoa : "/image/layout/default_post_thumbnail.jpg")" alt="Ảnh thumbnail bài viết">
                                    </div>
                                </div>
                                <div class="col-8">
                                    <div class="content">
                                        <h2 class="post-title"><a href="/thong-tin/hop-tac-doanh-nghiep/@post.Slug">@post.TieuDe</a></h2>
                                        <p class="summary">
                                            @post.NoiDung
                                        </p>
                                        <div class="metadata">
                                            <div class="metadata-item">
                                                <i class="fa-solid fa-clock"></i> @post.CreatedAt?.ToString("dd/MM/yyyy")
                                            </div>
                                            <div class="metadata-item">
                                                <i class="fa-solid fa-user-tie"></i> @post.TacGia
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <div class="text-center w-100 fs-4 fw-bold text-muted mt-5">
                        <i class="fa-solid fa-folder-open empty-icon"></i>
                        Không có bài viết nào
                    </div>
                }
            </div>
            <div class="pagination-wrapper">
                @await Html.PartialAsync("_Pagination", Model)
            </div>
        </div>
        <div class="col-12 col-xl-3 mt-5 mt-xl-0">
            @await Html.PartialAsync("_VerticalBanner")
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="/css/guest/post_page.css" />
}
