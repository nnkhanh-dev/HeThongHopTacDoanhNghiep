@using Microsoft.AspNetCore.Http.Extensions
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        var baseUrl = Configuration["BaseUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}";

        /* ===== og:url / canonical ===== */
        var ogUrl = ViewData["OgUrl"]?.ToString();

        if (string.IsNullOrEmpty(ogUrl))
        {
            ogUrl = baseUrl + Context.Request.Path;
        }
        else if (ogUrl.StartsWith("/"))
        {
            ogUrl = baseUrl + ogUrl;
        }

        /* ===== og:image ===== */
        var ogImage = ViewData["OgImage"]?.ToString();

        if (!string.IsNullOrEmpty(ogImage) && ogImage.StartsWith("/"))
        {
            ogImage = baseUrl + ogImage;
        }
    }

    
    <!-- Open Graph -->
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:title" content="@(ViewData["OgTitle"] ?? ViewData["Title"])" />
    <meta property="og:description" content="@(ViewData["OgDescription"] ?? "")" />
    <meta name="description" content="@ViewData["OgDescription"]" />
    <meta property="og:url" content="@ogUrl" />
    <link rel="canonical" href="@ogUrl" />
    <meta property="og:image" content="@ogImage" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["OgTitle"] ?? ViewData["Title"])" />
    <title>
        @(ViewData["Title"] != null ? ViewData["Title"] + " - " : "") Hệ thống Hợp tác doanh nghiệp - Đại học Công nghệ Kỹ thuật - Đại học Đà Nẵng
    </title>
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/css/guest/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HopTacDoanhNghiep.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.1.1/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @await Html.PartialAsync("_Header")

    <main>
        @await Html.PartialAsync("_Notification")
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="~/js/guest/swiper-init.js" asp-append-version="true"></script>
    <script src="~/js/guest/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
