@model HopTacDoanhNghiep.ViewModels.Common.BaseResult<HopTacDoanhNghiep.Areas.Admin.ViewModels.Nganh.NganhVM>
@{
    ViewData["Title"] = "Chi tiết ngành";
}

<div class="container">
    <div class="box">
        <div class="box-header mb-4">
            <i class="fa-solid fa-graduation-cap"></i> Chi tiết ngành
        </div>
        <div class="box-body">
            <div class="mb-3">
                <strong>Mã ngành:</strong>
                @Model.Data.MaNganh
            </div>
            <div class="mb-3">
                <strong>Tên ngành:</strong>
                @Model.Data.TenNganh
            </div>
            <div class="mb-3">
                <strong>Tên chuyên ngành:</strong>
                @(string.IsNullOrWhiteSpace(Model.Data.TenChuyenNganh) ? "N/A" : Model.Data.TenChuyenNganh)
            </div>
            <div class="mb-3">
                <strong>Ngày tạo:</strong>
                @(Model.Data.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
            </div>
            <div class="mb-3">
                <strong>Ngày cập nhật:</strong>
                @(Model.Data.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
            </div>

            <div class="d-flex gap-2">
                <a href="/admin/nganh" class="btn btn-secondary">Quay lại</a>
                <a href="/admin/nganh/chinh-sua/@Model.Data.Id" class="btn btn-primary">Cập nhật</a>
            </div>
        </div>
    </div>
</div>
