@model HopTacDoanhNghiep.Areas.Admin.ViewModels.Nganh.NganhEditVM
@{
    ViewData["Title"] = "Chỉnh sửa ngành";
}

<div class="container">
    <div class="box">
        <div class="box-header mb-4">
            <i class="fa-solid fa-graduation-cap"></i> Chỉnh sửa ngành
        </div>
        <div class="box-body">
            <form method="post" asp-action="Edit" asp-area="Admin" asp-controller="Nganh">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="MaNganh"><strong>Mã ngành</strong> <span class="text-danger">(*)</span></label>
                    <input asp-for="MaNganh" class="form-control" placeholder="Nhập mã ngành..." />
                    <span asp-validation-for="MaNganh" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="TenNganh"><strong>Tên ngành</strong> <span class="text-danger">(*)</span></label>
                    <input asp-for="TenNganh" class="form-control" placeholder="Nhập tên ngành..." />
                    <span asp-validation-for="TenNganh" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="TenChuyenNganh"><strong>Tên chuyên ngành</strong></label>
                    <input asp-for="TenChuyenNganh" class="form-control" placeholder="Nhập tên chuyên ngành..." />
                    <span asp-validation-for="TenChuyenNganh" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Chỉnh sửa</button>
                <a href="/admin/nganh" class="btn btn-secondary">Quay lại</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
