@model HopTacDoanhNghiep.ViewModels.Common.PageResult<HopTacDoanhNghiep.Areas.Admin.ViewModels.DanhMucBaiViet.DanhMucBaiVietVM>

@{
    ViewData["Title"] = "Quản lý danh mục bài viết";
}

<div class="container">
    <div class="box">
        <div class="box-header mb-4">
            <i class="fa-solid fa-newspaper"></i> Quản lý danh mục bài viết
        </div>
        <div class="box-body">
            <div class="mb-4">
                <div class="row">
                    <div class="col-12">
                        <a href="/admin/danh-muc-bai-viet/tao-moi" class="btn btn-success"><i class="fa-solid fa-plus"></i> Tạo mới</a>
                    </div>
                </div>
            </div>
            @await Html.PartialAsync("_Search")
            <div class="table-responsive mb-3">
                <table class="htdn-table">
                    <thead>
                        <tr>
                            <th>Tên danh mục</th>
                            <th>Chức năng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Records != null && Model.Records.Any())
                        {
                            foreach (var item in Model.Records)
                            {
                                <tr>
                                    <td>@item.Ten</td>
                                    <td>
                                        <a href="/admin/danh-muc-bai-viet/chi-tiet/@item.MaDanhMuc" class="btn btn-sm btn-warning text-white">
                                            <i class="fa-solid fa-eye"></i> Xem
                                        </a>
                                        <a href="/admin/danh-muc-bai-viet/chinh-sua/@item.MaDanhMuc" class="btn btn-sm btn-primary">
                                            <i class="fa-solid fa-edit"></i> Sửa
                                        </a>
                                        <button class="btn btn-sm btn-danger" onclick="DeleteDanhMucBaiViet(@item.MaDanhMuc)">
                                            <i class="fa-solid fa-trash"></i> Xóa
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="text-center">Không có dữ liệu</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-wrapper">
                @await Html.PartialAsync("_Pagination", Model)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/BaiViet/DanhMucBaiViett.js"></script>
}