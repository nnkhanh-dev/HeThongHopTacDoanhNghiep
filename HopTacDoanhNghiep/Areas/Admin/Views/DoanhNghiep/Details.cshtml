@model HopTacDoanhNghiep.ViewModels.Common.BaseResult<HopTacDoanhNghiep.Areas.Admin.ViewModels.DoanhNghiep.DoanhNghiepVM>
@{
    ViewData["Title"] = "Chi tiết doanh nghiệp";
}

<div class="container">
    <div class="box">
        <div class="box-header mb-4">
            <i class="fa-solid fa-newspaper"></i> Chi tiết doanh nghiệp
        </div>
        <div class="box-body">
            @if (!string.IsNullOrWhiteSpace(Model.Data.Logo))
            {
                <div class="mb-3">
                    <strong>Logo:</strong>
                    <img src="@Model.Data.Logo" alt="Logo công ty">
                </div>
            }

            <div class="mb-3">
                <strong>Mã doanh nghiệp:</strong>
                @Model.Data.MaDN
            </div>
            <div class="mb-3">
                <strong>Tên hiển thị:</strong>
                @Model.Data.TenHienThi
            </div>
            <div class="mb-3">
                <strong>Tên pháp lý:</strong>
                @Model.Data.TenPhapLy
            </div>
            <div class="mb-3">
                <strong>Mã số thuế:</strong>
                @Model.Data.MaSoThue
            </div>
            <div class="mb-3">
                <strong>Ngày thành lập:</strong>
                @Model.Data.NgayThanhLap?.ToString("dd/MM/yyyy")
            </div>
            <div class="mb-3">
                <strong>Email:</strong>
                @Model.Data.Email
            </div>
            <div class="mb-3">
                <strong>Số điện thoại:</strong>
                @Model.Data.SDT
            </div>
            <div class="mb-3">
                <strong>Quy mô nhân sự:</strong>
                @Model.Data.QuyMoNhanSu
            </div>
            <div class="mb-3">
                <strong>Địa chỉ:</strong>
                @Model.Data.DiaChi
            </div>
            <div class="mb-3">
                <strong>Giới thiệu:</strong>
                @Model.Data.GioiThieu
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Data.Website))
            {
                <div class="mb-3">
                    <strong>Website:</strong>
                    <a href="@Model.Data.Website" target="_blank">Xem ngay</a>
                </div>
            }
            <div class="mb-3">
                <strong>Ghi chú:</strong>
                @Model.Data.GhiChu
            </div>

            <div class="d-flex gap-2">
                <a href="/admin/doanh-nghiep" class="btn btn-secondary">Quay lại</a>
                <a href="/admin/doanh-nghiep/chinh-sua/@Model.Data.Id" class="btn btn-primary">Cập nhật</a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="/css/admin/Authentication/authentication.css" rel="stylesheet" />
}