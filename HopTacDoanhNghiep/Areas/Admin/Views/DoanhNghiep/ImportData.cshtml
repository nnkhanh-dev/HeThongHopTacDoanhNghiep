@using HopTacDoanhNghiep.Enums.NhapDuLieu
@model HopTacDoanhNghiep.ViewModels.Common.PageResult<HopTacDoanhNghiep.Areas.Admin.ViewModels.NhapDuLieu.LichSuNhapDuLieuVM>

@{
    ViewData["Title"] = "Import dữ liệu doanh nghiệp";
    var statusFilter = Context.Request.Query["status"].ToString();
}

<div class="container">
    <div class="box">
        <div class="box-header mb-4">
            <i class="fa-solid fa-arrow-up-from-bracket"></i> Nhập dữ liệu doanh nghiệp
        </div>
        <div class="box-body">
            <div class="mb-4">
                <div class="row">
                    <div class="col-12">
                        <a href="/uploads/file-mau/Template_DoanhNghiep.xlsx" download class="btn btn-warning text-white">
                            <i class="fa-solid fa-download"></i> Tải File mẫu
                        </a>
                        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#uploadModal">
                            <i class="fa-solid fa-arrow-up-from-bracket"></i> Nhập dữ liệu
                        </button>
                    </div>
                </div>
            </div>

            <!-- Filters -->
            <div class="card mb-3 p-3">
                <form method="get" action="/admin/doanh-nghiep/nhap-du-lieu">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <input type="text"
                                   class="form-control"
                                   name="keyword"
                                   placeholder="Tìm kiếm..."
                                   value="@Context.Request.Query["keyword"]">
                        </div>
                        <div class="col-12 col-md-6">
                            <select class="form-select" name="status">
                                <option value="">Tất cả trạng thái</option>
                                <option value="0" selected="@(statusFilter == "0")">Chờ xử lý</option>
                                <option value="1" selected="@(statusFilter == "1")">Đã xử lý</option>
                                <option value="2" selected="@(statusFilter == "2")">Lỗi hệ thống</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-search"></i> Tìm kiếm
                            </button>
                            @if (!string.IsNullOrEmpty(Context.Request.Query["keyword"]) || !string.IsNullOrEmpty(statusFilter))
                            {
                                <a href="/admin/doanh-nghiep/nhap-du-lieu" class="btn btn-secondary">
                                    <i class="fa-solid fa-times"></i> Xóa bộ lọc
                                </a>
                            }
                        </div>
                    </div>

                    @* Giữ pageSize nếu có *@
                    @if (!string.IsNullOrEmpty(Context.Request.Query["pageSize"]))
                    {
                        <input type="hidden" name="pageSize" value="@Context.Request.Query["pageSize"]" />
                    }
                </form>
            </div>

            <div class="table-responsive mb-3">
                <table class="htdn-table">
                    <thead>
                        <tr>
                            <th style="width:25%">Thời điểm</th>
                            <th style="width:15%">Trạng thái</th>
                            <th style="width:15%">Tổng dữ liệu</th>
                            <th style="width:15%">Thành công</th>
                            <th style="width:15%">Thất bại</th>
                            <th style="width:15%">File lỗi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Records != null && Model.Records.Any())
                        {
                            foreach (var item in Model.Records)
                            {
                                <tr>
                                    <td>@item.CreatedAt?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td>
                                        @switch (item.TrangThai)
                                        {
                                            case NhapDuLieuStatus.ChoXuLy:
                                                <span class="badge bg-secondary">Chờ xử lý</span>
                                                break;
                                            case NhapDuLieuStatus.DaXuLy:
                                                <span class="badge bg-success">Đã xử lý</span>
                                                break;
                                            case NhapDuLieuStatus.Loi:
                                                <span class="badge bg-danger text-white">Lỗi hệ thống</span>
                                                break;
                                            default:
                                                <span class="badge bg-dark">Không xác định</span>
                                                break;
                                        }
                                    </td>
                                    <td>@item.TongDuLieu</td>
                                    <td>@item.ThanhCong</td>
                                    <td>@item.ThatBai</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.DuongDanFileLoi))
                                        {
                                            <a href="@item.DuongDanFileLoi" class="btn btn-sm btn-danger text-white" download>
                                                <i class="fa-solid fa-download"></i> Tải file lỗi
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">Không có dữ liệu</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-wrapper">
                @await Html.PartialAsync("_Pagination", Model)
            </div>

            <div class="d-flex gap-2">
                <a href="/admin/doanh-nghiep" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </div>
</div>

<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="uploadModalLabel">
                    <i class="fa-solid fa-arrow-up-from-bracket"></i> Nhập dữ liệu doanh nghiệp
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="uploadForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="excelFile" class="form-label">Chọn file Excel (.xlsx)</label>
                        <input type="file"
                               class="form-control"
                               id="excelFile"
                               name="file"
                               accept=".xlsx"
                               required>
                        <div class="form-text">
                            <i class="fa-solid fa-info-circle"></i>
                            Chỉ chấp nhận file .xlsx, tối đa 10MB
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnUpload">
                    <i class="fa-solid fa-upload"></i> Tải lên
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const fileInput = $('#excelFile');
            const btnUpload = $('#btnUpload');
            const uploadModal = new bootstrap.Modal(document.getElementById('uploadModal'));

            // Reset form when modal is closed
            $('#uploadModal').on('hidden.bs.modal', function () {
                $('#uploadForm')[0].reset();
                btnUpload.prop('disabled', false);
            });

            // Upload button click
            btnUpload.on('click', function () {
                const file = fileInput[0].files[0];

                if (!file) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Chưa chọn file!',
                        text: 'Vui lòng chọn file Excel để tải lên.',
                        confirmButtonText: 'Đồng ý'
                    });
                    return;
                }

                // Validate file extension
                const fileName = file.name.toLowerCase();
                if (!fileName.endsWith('.xlsx')) {
                    Swal.fire({
                        icon: 'error',
                        title: 'File không hợp lệ!',
                        text: 'Chỉ chấp nhận file có định dạng .xlsx',
                        confirmButtonText: 'Đồng ý'
                    });
                    return;
                }

                // Validate file size (10MB)
                if (file.size > 10 * 1024 * 1024) {
                    Swal.fire({
                        icon: 'error',
                        title: 'File quá lớn!',
                        text: 'Kích thước file không được vượt quá 10MB',
                        confirmButtonText: 'Đồng ý'
                    });
                    return;
                }

                uploadFile(file);
            });

            function uploadFile(file) {
                const formData = new FormData();
                formData.append('file', file);

                btnUpload.prop('disabled', true);

                // Show loading
                Swal.fire({
                    title: 'Đang tải lên...',
                    html: 'Vui lòng đợi trong giây lát',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '/admin/doanh-nghiep/nhap-du-lieu/upload-excel',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công!',
                                text:  response.message || 'File đã được tải lên và đang được xử lý.',
                                confirmButtonText: 'Đồng ý',
                                timer: 3000
                            }).then(() => {
                                uploadModal.hide();
                                location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Thất bại!',
                                text: response.message || 'Có lỗi xảy ra khi tải lên file.',
                                confirmButtonText: 'Đồng ý'
                            });
                            btnUpload.prop('disabled', false);
                        }
                    },
                    error: function (xhr) {
                        let errorMessage = 'Có lỗi xảy ra trong quá trình tải lên!';

                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        }

                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi!',
                            text: errorMessage,
                            confirmButtonText: 'Đồng ý'
                        });

                        btnUpload.prop('disabled', false);
                    }
                });
            }
        });
    </script>
}

