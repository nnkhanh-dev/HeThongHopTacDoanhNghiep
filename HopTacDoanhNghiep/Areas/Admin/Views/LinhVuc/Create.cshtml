@model HopTacDoanhNghiep.Areas.Admin.ViewModels.LinhVuc.LinhVucCreateVM
@{
    ViewData["Title"] = "Tạo lĩnh vực";
}

<div class="container">
    <div class="box">
        <div class="box-header mb-4">
            <i class="fa-solid fa-briefcase"></i> Tạo lĩnh vực
        </div>
        <div class="box-body">
            <form method="post" asp-action="Create" asp-area="Admin" asp-controller="LinhVuc">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="Ten"><strong>Tên lĩnh vực</strong> <span class="text-danger">(*)</span></label>
                    <input asp-for="Ten" class="form-control" placeholder="Nhập tên lĩnh vực..." />
                    <span asp-validation-for="Ten" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="MoTa"><strong>Mô tả</strong></label>
                    <textarea asp-for="MoTa" class="form-control" rows="5" placeholder="Nhập mô tả lĩnh vực..."></textarea>
                    <span asp-validation-for="MoTa" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">Tạo lĩnh vực</button>
                <a href="/admin/linh-vuc" class="btn btn-secondary">Quay lại</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
