@model HopTacDoanhNghiep.ViewModels.Common.BaseResult<HopTacDoanhNghiep.Areas.Admin.ViewModels.LinhVuc.LinhVucVM>
@{
    ViewData["Title"] = "Chi tiết lĩnh vực";
}

<div class="container">
    <div class="box">
        <div class="box-header mb-4">
            <i class="fa-solid fa-briefcase"></i> Chi tiết lĩnh vực
        </div>
        <div class="box-body">
            <div class="mb-3">
                <strong>Tên lĩnh vực:</strong>
                @Model.Data.Ten
            </div>
            <div class="mb-3">
                <strong>Mô tả:</strong>
                @(string.IsNullOrWhiteSpace(Model.Data.MoTa) ? "N/A" : Model.Data.MoTa)
            </div>
            <div class="mb-3">
                <strong>Slug:</strong>
                @(string.IsNullOrWhiteSpace(Model.Data.Slug) ? "N/A" : Model.Data.Slug)
            </div>
            <div class="mb-3">
                <strong>Ngày tạo:</strong>
                @(Model.Data.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
            </div>
            <div class="mb-3">
                <strong>Ngày cập nhật:</strong>
                @(Model.Data.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
            </div>

            <div class="d-flex gap-2">
                <a href="/admin/linh-vuc" class="btn btn-secondary">Quay lại</a>
                <a href="/admin/linh-vuc/chinh-sua/@Model.Data.Id" class="btn btn-primary">Cập nhật</a>
            </div>
        </div>
    </div>
</div>
