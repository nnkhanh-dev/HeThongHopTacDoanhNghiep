@using HopTacDoanhNghiep.ViewModels.Common
@model HopTacDoanhNghiep.ViewModels.Common.BaseResult<HopTacDoanhNghiep.Areas.Student.ViewModels.BaiViet.BaiVietVM>
@{
    var data = Model.Data;
    ViewData["Title"] = Model.Data?.TieuDe;
    ViewData["OgType"] = "article";
    ViewData["OgTitle"] = Model.Data?.TieuDe;
    ViewData["OgDescription"] =
        Model.Data?.TieuDe;
    ViewData["OgUrl"] = $"/sinh-vien/thong-tin/thong-bao/{Model.Data?.Slug}";
}

<div class="container mb-4">

    <article class="row">
        <div class="box">
            <h1 class="page-title">@data.TieuDe</h1>
            <div class="metadata">
                <div class="metadata-item">
                    <i class="fa-solid fa-clock"></i> @data.CreatedAt?.ToString("dd/MM/yyyy")
                </div>
                <div class="metadata-item">
                    <i class="fa-solid fa-user-tie"></i> @data.TacGia
                </div>
            </div>
            <hr>
            
            @Html.Raw(data.NoiDung)

            @await Html.PartialAsync("_ShareSocial",
            new ShareSocialVM {
                Url = $"/sinh-vien/thong-tin/thong-bao/{data?.Slug}",
                Title = data?.TieuDe
            })

            <hr>

            @{
                if(data.BaiVietLienQuan != null && data.BaiVietLienQuan.Any())
                {
                    <div>
                        <h3>Thông báo khác</h3>
                        <div class="list-related">
                            @{
                                foreach(var related in data.BaiVietLienQuan)
                                {
                                    <div class="related-item">
                                        <a href="/sinh-vien/thong-tin/thong-bao/@related.Slug"><i class="fa-solid fa-circle-right"></i> @related.TieuDe</a>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            }  
            
            <div class="box-footer mt-3">
                 <a href="/sinh-vien/thong-tin/thong-bao" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Quay lại
                </a>
            </div>
        </div>

    </article>
</div>

@section Styles {
    <link rel="stylesheet" href="/css/guest/post_page.css" />
}

@section Scripts {
    <script src="/js/guest/ShareSocial.js"></script>
}
