@model HopTacDoanhNghiep.Areas.Student.ViewModels.SinhVien.EditSinhVienVM

@{
    ViewData["Title"] = "Cập nhật thông tin sinh viên";
}

<div class="container">
    <div class="box mb-4">
        <div class="box-header mb-3">
            <i class="fa-solid fa-user-graduate"></i> Cập nhật thông tin sinh viên
        </div>

        <div class="box-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data" class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"><strong>Email</strong></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SDT" class="form-label"><strong>Số điện thoại</strong></label>
                    <input asp-for="SDT" class="form-control" />
                    <span asp-validation-for="SDT" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="HoSoNangLuc" class="form-label"><strong>Hồ sơ năng lực</strong></label>
                    <input asp-for="HoSoNangLuc" class="form-control" type="url" />
                    <span asp-validation-for="HoSoNangLuc" class="text-danger"></span>
                </div>
                <div class="col-12">
                    @if (!string.IsNullOrEmpty(Model.AnhThe))
                    {
                        <p><strong>Avatar hiện tại:</strong></p>
                        <img src="@Url.Content(Model.AnhThe)" alt="Avatar" class="img-thumbnail" style="max-width:150px;" />
                    }
                    <div class="mt-3">
                        <label class="form-label"><strong>Upload Avatar</strong></label>
                        <input type="file" name="AvatarFile" class="form-control" accept="image/*" />
                    </div>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}