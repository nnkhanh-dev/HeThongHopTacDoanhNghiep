@model HopTacDoanhNghiep.Areas.Student.ViewModels.HomeVM.HomeVM
@using HopTacDoanhNghiep.Enums.HoSo
@using HopTacDoanhNghiep.Enums.ViecLam

@{
    ViewData["Title"] = "Trang chủ";
    var keyword = Context.Request.Query["keyword"].ToString();
}

<div class="container">
    <div class="box">
        <div class="box-header mb-4">
            <i class="fa-solid fa-house"></i> Trang chủ
        </div>
        <div class="box-body">
            <section>
                <div class="container">
                    <div class="row">
                        <div class="col-12 col-lg-8 mb-4 mb-lg-0">
                            <h2 class="section-header w-100 mb-3"><a href="/thong-tin/tin-tuc"><i class="fa-solid fa-newspaper me-2"></i> Tin tức</h2>
                            <div class="row">
                                <div class="col-12 col-lg-6 mb-3 mb-lg-0">
                                    @if (Model?.TinTucs != null && Model.TinTucs.Any())
                                    {
                                        var latest = Model.TinTucs.First();
                                        <div class="lastest-news">
                                            <div class="thumbnail mb-2">
                                                <img src="@(string.IsNullOrEmpty(latest.AnhMinhHoa) ? "/image/layout/default_noti_thumbnail.jpg" : latest.AnhMinhHoa)" class="w-100" alt="thumbnail" loading="lazy">
                                            </div>
                                            <div>
                                                <div class="title mb-2">
                                                    <a href="/sinh-vien/thong-tin/tin-tuc/@(latest.Slug ?? "")">@latest.TieuDe</a>
                                                </div>
                                                <div class="meta">
                                                    <div class="meta-item"><i class="fa-solid fa-calendar"></i> @(latest.CreatedAt?.ToString("dd/MM/yyyy"))</div>
                                                    <div class="meta-item highlight"><i class="fa-solid fa-fire"></i> Mới nhất</div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="lastest-news">
                                            <div class="thumbnail mb-2">
                                                <img src="/image/layout/default_noti_thumbnail.jpg" class="w-100" alt="thumbnail" loading="lazy">
                                            </div>
                                            <div>
                                                <div class="title mb-2">
                                                    <a href="#">Chưa có tin tức</a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="col-12 col-lg-6">
                                    <div class="list-news">
                                        @if (Model?.TinTucs != null && Model.TinTucs.Count > 1)
                                        {
                                            foreach (var item in Model.TinTucs.Skip(1).Take(5))
                                            {
                                                <div class="news">
                                                    <div class="row">
                                                        <div class="col-4">
                                                            <div class="thumbnail">
                                                                <img src="@(string.IsNullOrEmpty(item.AnhMinhHoa) ? "/image/layout/default_noti_thumbnail.jpg" : item.AnhMinhHoa)" class="w-100" alt="thumbnail" loading="lazy">
                                                            </div>
                                                        </div>
                                                        <div class="col-8">
                                                            <div>
                                                                <div class="title">
                                                                    <a href="/sinh-vien/thong-tin/tin-tuc/@(item.Slug ?? "")">@item.TieuDe</a>
                                                                </div>

                                                                <div class="meta">
                                                                    <i class="fa-solid fa-calendar"></i> @(item.CreatedAt?.ToString("dd/MM/yyyy"))
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="news">Chưa có tin tức khác</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <h2 class="section-header w-100 mb-3"><a href="/thong-tin/thong-bao"><i class="fa-solid fa-bell me-2"></i> Thông báo</a></h2>
                            <div class="list-notis">
                                @if (Model?.ThongBaos != null && Model.ThongBaos.Any())
                                {
                                    foreach (var noti in Model.ThongBaos.Take(5))
                                    {
                                        <div class="noti">
                                            <div class="row">
                                                <div class="col-4">
                                                    <div class="thumbnail">
                                                        <img src="@(string.IsNullOrEmpty(noti.AnhMinhHoa) ? "/image/layout/default_noti_thumbnail.jpg" : noti.AnhMinhHoa)" class="w-100" alt="thumbnail" loading="lazy">
                                                    </div>
                                                </div>
                                                <div class="col-8">
                                                    <div>
                                                        <div class="title">
                                                            <a href="/sinh-vien/thong-tin/thong-bao/@(noti.Slug ?? "")">@noti.TieuDe</a>
                                                        </div>
                                                        <div class="meta">
                                                            <i class="fa-solid fa-calendar"></i> @(noti.CreatedAt?.ToString("dd/MM/yyyy"))
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="noti">Chưa có thông báo</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section>
                <div class="container">
                    <h2 class="section-header w-100 mb-3"><a href="/sinh-vien/tin-tuyen-dung"><i class="fa-solid fa-globe me-2"></i> Tin tuyển dụng</a></h2>
                    <div class="list-jobs mb-4">
                        @if (Model.ViecLams != null && Model.ViecLams.Any())
                        {
                            foreach (var item in Model.ViecLams)
                            {
                                var isValid = item.NgayBatDau <= DateTime.UtcNow && item.NgayHetHan >= DateTime.UtcNow;
                                <div class="job mb-3">
                                    <div class="job-header">
                                        <img src="@item.LogoDoanhNghiep" alt="Logo doanh nghiệp">
                                    </div>
                                    <div class="job-body mt-3">
                                        <h3 class="job-title"><a href="/sinh-vien/tin-tuyen-dung/@item.Slug">@item.TieuDe</a></h3>
                                        <div>
                                            <i class="fa-solid fa-piggy-bank"></i> @((item.LuongToiThieu?.ToString("N0") ?? "0") + " - " + (item.LuongToiDa?.ToString("N0") ?? "0")) VNĐ
                                        </div>
                                        <div>
                                            <i class="fa-solid fa-clock-rotate-left"></i> @item.NgayBatDau?.ToString("dd/MM/yyyy") - @item.NgayHetHan?.ToString("dd/MM/yyyy")
                                        </div>
                                        <div>
                                            <i class="fa-solid fa-cubes"></i>
                                            @switch (item.LoaiViecLam)
                                            {
                                                case ViecLamType.BanThoiGian:
                                                    <span> Bán thời gian</span>
                                                    break;
                                                case ViecLamType.ToanThoiGian:
                                                    <span> Toàn thời gian</span>
                                                    break;
                                                case ViecLamType.ThucTap:
                                                    <span> Thực tập</span>
                                                    break;
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center w-100 fs-4 fw-bold text-muted mt-5">
                                <i class="fa-solid fa-folder-open empty-icon"></i>
                                Không có tin tuyển dụng nào
                            </div>
                        }

                    </div>
                    <div class="text-center">
                        <a href="/sinh-vien/tin-tuyen-dung" class="btn btn-more">Xem tất cả <i class="fa-solid fa-circle-chevron-right ms-2"></i></a>
                    </div>
                </div>
            </section>

            <section>
                <div class="container">
                    <h2 class="section-header w-100 mb-3"><a href="/bai-viet"><i class="fa-solid fa-earth-americas me-2"></i> Bài viết</a></h2>
                    <div class="swiper posts-slider">
                        <div class="swiper-wrapper">
                            @* Generate remaining 12 posts with swiper-slide wrapper *@
                            @if (Model?.BaiViets != null && Model.BaiViets.Any())
                            {
                                foreach (var post in Model.BaiViets.Take(12))
                                {
                                    <div class="swiper-slide">
                                        <div class="post">
                                            <div class="thumbnail mb-3">
                                                <img src="@(string.IsNullOrEmpty(post.AnhMinhHoa) ? "/image/layout/default_noti_thumbnail.jpg" : post.AnhMinhHoa)" alt="ảnh thumbnail" loading="lazy">
                                            </div>
                                            <div>
                                                <div class="meta mb-2">
                                                    <div class="meta-item"><i class="fa-solid fa-calendar"></i> @(post.CreatedAt?.ToString("dd/MM/yyyy"))</div>
                                                    <div class="meta-item"><i class="fa-solid fa-list"></i> @(post.DanhMuc ?? "")</div>
                                                </div>
                                                <div class="title">
                                                    <a href="/bai-viet/@(post.Slug ?? "")">@post.TieuDe</a>
                                                </div>
                                                <div class="summary">
                                                    @Html.Raw(post.NoiDung)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="swiper-slide">
                                    <div class="post">Chưa có bài viết</div>
                                </div>
                            }
                        </div>

                        <!-- Pagination -->
                        <div class="swiper-pagination"></div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Styles {
    <link href="/css/student/ViecLam/ViecLam.css" rel="stylesheet" />
}
