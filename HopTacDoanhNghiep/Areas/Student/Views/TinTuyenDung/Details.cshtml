@using HopTacDoanhNghiep.Enums.ViecLam
@model HopTacDoanhNghiep.ViewModels.Common.BaseResult<HopTacDoanhNghiep.Areas.Student.ViewModels.ViecLam.TinTuyenDungVM>
@{
    ViewData["Title"] = "Chi tiết việc làm";
    var tinTuyenDung = Model?.Data;
    var isValid = tinTuyenDung?.NgayBatDau <= DateTime.UtcNow && tinTuyenDung?.NgayHetHan >= DateTime.UtcNow;
}

<div class="container">
    <div class="box">
        <div class="box-header mb-4">
            <i class="fa-solid fa-briefcase"></i> Chi tiết tin tuyển dụng
        </div>
        <div class="box-body">
            @if (tinTuyenDung == null)
            {
                <div class="alert alert-warning mb-0">
                    Không tìm thấy thông tin tin tuyển dụng.
                </div>
                return;
            }

            <div>
                <div class="mb-3">
                    <strong>Tiêu đề:</strong>
                    <p>@tinTuyenDung.TieuDe</p>
                </div>
                <div class="mb-3">
                    <strong>Địa điểm:</strong>
                    <p>@tinTuyenDung.DiaDiem</p>
                </div>
                <div class="row">
                    <div class="col-12 col-md-6">
                        <div class="mb-3">
                            <strong>Loại việc làm:</strong>
                            <p>
                                @switch (tinTuyenDung.LoaiViecLam)
                                {
                                    case ViecLamType.BanThoiGian:
                                        <span class="badge bg-warning text-dark">Bán thời gian</span>
                                        break;
                                    case ViecLamType.ToanThoiGian:
                                        <span class="badge bg-primary">Toàn thời gian</span>
                                        break;
                                    case ViecLamType.ThucTap:
                                        <span class="badge bg-info">Thực tập</span>
                                        break;
                                }
                            </p>
                        </div>
                        <div class="mb-3">
                            <strong>Đối tượng:</strong>
                            <p>
                                @switch (tinTuyenDung.DoiTuongUngTuyen)
                                {
                                    case DoiTuongUngTuyen.ThucTapSinh:
                                        <span>Thực tập sinh</span>
                                        break;
                                    case DoiTuongUngTuyen.SinhVienNamCuoi:
                                        <span>Sinh viên năm cuối</span>
                                        break;
                                    case DoiTuongUngTuyen.MoiTotNghiep:
                                        <span>Mới tốt nghiệp</span>
                                        break;
                                    case DoiTuongUngTuyen.DaTotNghiep:
                                        <span>Đã tốt nghiệp</span>
                                        break;
                                }
                            </p>
                        </div>
                        <div class="mb-3">
                            <strong>Trình độ:</strong>
                            <p>
                                @switch (tinTuyenDung.TrinhDo)
                                {
                                    case TrinhDoType.TrungCap:
                                        <span>Trung cấp</span>
                                        break;
                                    case TrinhDoType.CaoDang:
                                        <span>Cao đẳng</span>
                                        break;
                                    case TrinhDoType.DaiHoc:
                                        <span>Đại học</span>
                                        break;
                                    case TrinhDoType.SauDaiHoc:
                                        <span>Sau đại học</span>
                                        break;
                                }
                            </p>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="mb-3">
                            <strong>Lương:</strong>
                            <p>@((tinTuyenDung.LuongToiThieu?.ToString("N0") ?? "0") + " - " + (tinTuyenDung.LuongToiDa?.ToString("N0") ?? "0")) VNĐ</p>
                        </div>
                        <div class="mb-3">
                            <strong>Ngày bắt đầu:</strong>
                            <p>@tinTuyenDung.NgayBatDau?.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="mb-3">
                            <strong>Ngày hết hạn:</strong>
                            <p>@tinTuyenDung.NgayHetHan?.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                </div>
            </div>

            <hr />

            <div class="mb-3">
                <strong>Mô tả công việc:</strong>
                <div class="content-box">
                    @Html.Raw(tinTuyenDung.MoTa)
                </div>
            </div>

            <div class="mb-3">
                <strong>Yêu cầu công việc:</strong>
                <div class="content-box">
                    @Html.Raw(tinTuyenDung.YeuCau)
                </div>
            </div>

            <div class="mb-3">
                <strong>Quyền lợi:</strong>
                <div class="content-box">
                    @Html.Raw(tinTuyenDung.QuyenLoi)
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(tinTuyenDung.UuTien))
            {
                <div class="mb-3">
                    <strong>Ưu tiên:</strong>
                    <div class="content-box">
                        @Html.Raw(tinTuyenDung.UuTien)
                    </div>
                </div>
            }

            <div class="d-flex gap-2">
                <a href="/sinh-vien/tin-tuyen-dung" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
                <button type="button" class="btn btn-apply btn-success" data-bs-toggle="modal" data-bs-target="#applyDonUngTuyenModal">
                    <i class="fa-solid fa-paper-plane"></i> Ứng tuyển
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="applyDonUngTuyenModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="applyDonUngTuyenForm" method="post" action="/sinh-vien/don-ung-tuyen" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Ứng tuyển</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="MaTTD" value="@tinTuyenDung.MaTTD" />

                    <div class="mb-3">
                        <label for="hoSoUngTuyen" class="form-label">Hồ sơ ứng tuyển</label>
                        <input type="file" class="form-control" id="hoSoUngTuyen" name="hoSoUngTuyen" accept=".pdf,.doc,.docx" required />
                        <div class="form-text">Chỉ chấp nhận file PDF, DOC hoặc DOCX, tối đa 10MB.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary" id="submitDonUngTuyenBtn">Nộp hồ sơ</button>
                </div>
            </form>
        </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="/css/student/ViecLam/ViecLam.css" rel="stylesheet" />
}

@section Scripts {
    <script src="/js/student/ViecLam/ViecLamChiTiet.js"></script>
}