@using System.Security.Claims

<header class="header">
    <button class="sidebar-toggle" id="sidebarToggle">
        <i class="fa-solid fa-bars"></i>
    </button>
    
    <div class="header-right">
        <div class="header-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Tìm kiếm...">
        </div>
        
        <div class="header-notifications">
            <button class="notification-btn">
                <i class="fa-solid fa-bell"></i>
                <span class="notification-badge">3</span>
            </button>
        </div>
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "User";
            var avatar = User.FindFirst("Avatar")?.Value;
            
            <div class="header-user dropdown">
                <button class="user-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="user-avatar">
                        @if (!string.IsNullOrEmpty(avatar))
                        {
                            <img src="@avatar" alt="@fullName" />
                        }
                        else
                        {
                            <img src="/image/layout/avatar_default.png" alt="Ảnh đại diện" />
                        }
                    </div>
                    <span class="user-name">@fullName</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                    <li><a class="dropdown-item" href="/doanh-nghiep/nguoi-dai-dien"><i class="fa-solid fa-user"></i> Tài khoản</a></li>
                    <li><a class="dropdown-item" href="/doanh-nghiep/thong-tin"><i class="fa-solid fa-building"></i> Doanh Nghiệp</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form method="post" action="/dang-xuat">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item btn btn-link py-2 px-4 m-0" style="color:inherit; text-decoration:none;">
                                <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <div class="header-user">
                <a href="/dang-nhap" class="btn btn-sm btn-primary">
                    <i class="fa-solid fa-right-to-bracket"></i> Đăng nhập
                </a>
            </div>
        }
    </div>
</header>
