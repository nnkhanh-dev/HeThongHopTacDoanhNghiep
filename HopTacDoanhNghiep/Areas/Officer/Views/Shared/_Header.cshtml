@using System.Security.Claims
@using Microsoft.AspNetCore.WebUtilities

@{
    var keyword = Context.Request.Query["keyword"].ToString();
    var currentPath = Context.Request.Path.StartsWithSegments("/can-bo/trang-chu")
        ? "/can-bo/bai-viet"
        : Context.Request.Path.Value;
    var clearQuery = Context.Request.Query.ToDictionary(x => x.Key, x => x.Value.ToString());
    clearQuery.Remove("keyword");
    clearQuery.Remove("pageIndex");
    var clearUrl = QueryHelpers.AddQueryString(currentPath, clearQuery);
}

<header class="header">
    <button class="sidebar-toggle" id="sidebarToggle">
        <i class="fa-solid fa-bars"></i>
    </button>
    
    <div class="header-right">
        <form class="header-search" method="get" action="@currentPath">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="keyword" placeholder="Tìm kiếm..." value="@keyword">
            <input type="hidden" name="pageIndex" value="1" />
            @if (!string.IsNullOrWhiteSpace(Context.Request.Query["pageSize"]))
            {
                <input type="hidden" name="pageSize" value="@Context.Request.Query["pageSize"]" />
            }
            @if (!string.IsNullOrWhiteSpace(keyword))
            {
                <a href="@clearUrl" class="header-search-clear" title="Xóa tìm kiếm">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            }
        </form>
        @* <div class="header-notifications">
            <button class="notification-btn">
                <i class="fa-solid fa-bell"></i>
                <span class="notification-badge">3</span>
            </button>
        </div> *@
        
        @if (User.Identity?.IsAuthenticated == true)
        {
            var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "User";
            var avatar = User.FindFirst("Avatar")?.Value;
            
            <div class="header-user dropdown">
                <button class="user-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="user-avatar">
                        @if (!string.IsNullOrEmpty(avatar))
                        {
                            <img src="@avatar" alt="@fullName" />
                        }
                        else
                        {
                            <img src="/image/layout/avatar_default.png" alt="Ảnh đại diện" />
                        }
                    </div>
                    <span class="user-name">@fullName</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                    <li><a class="dropdown-item" href="/can-bo/ho-so"><i class="fa-solid fa-user"></i> Tài khoản</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form method="post" action="/dang-xuat">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item btn btn-link py-2 px-4 m-0" style="color:inherit; text-decoration:none;">
                                <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <div class="header-user">
                <a href="/dang-nhap" class="btn btn-sm btn-primary">
                    <i class="fa-solid fa-right-to-bracket"></i> Đăng nhập
                </a>
            </div>
        }
    </div>
</header>
