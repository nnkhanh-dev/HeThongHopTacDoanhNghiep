<aside class="sidebar" id="sidebar">
    @{
        var isKhoa = User.FindFirst("isKhoa")?.Value == "true";
        var isBGH = User.FindFirst("isBGH")?.Value == "true";
        var isPCTSV = User.FindFirst("isPCTSV")?.Value == "true";
    }

    <div class="sidebar-header">
        <a href="/can-bo/trang-chu" class="sidebar-brand">
            <img src="/image/layout/logo_htdn_basic.png" alt="Logo HTDN">
        </a>
        <button class="sidebar-close" id="sidebarClose">
            <i class="fa-solid fa-times"></i>
        </button>
    </div>
    
    <hr class="w-100">
    
    <nav class="sidebar-nav">
        <div class="nav-item">
            <a href="/can-bo/trang-chu">
                <i class="fa-solid fa-house"></i>
                <span>Trang chủ</span>
            </a>
        </div>
        
        <hr class="w-100">

        <div class="nav-submenu">
            <div class="nav-submenu-header">
                <i class="fa-solid fa-building"></i>
                <span>Doanh Nghiệp</span>
                <i class="fa-solid fa-chevron-down submenu-arrow"></i>
            </div>
            <div class="submenu">
                <div class="submenu-item">
                    <a href="/can-bo/doanh-nghiep/danh-sach">Danh sách</a>
                </div>
                @if (isKhoa)
                {
                    <div class="submenu-item">
                        <a href="/can-bo/doanh-nghiep/hop-tac">Hợp tác</a>
                    </div>
                }
                @if (isBGH || isPCTSV)
                {
                    <div class="submenu-item">
                        <a href="/can-bo/doanh-nghiep/dang-ky">Đăng ký</a>
                    </div>
                }
            </div>
        </div>

        <hr class="w-100">

        <div class="nav-item">
            <a href="/can-bo/thong-tin/tin-tuc">
                <i class="fa-solid fa-newspaper"></i>
                <span>Tin tức</span>
            </a>
        </div>

        <hr class="w-100">

        <div class="nav-item">
            <a href="/can-bo/thong-tin/thong-bao">
                <i class="fa-solid fa-bell"></i>
                <span>Thông báo</span>
            </a>
        </div>

        <hr class="w-100">

        <div class="nav-item">
            <a href="/can-bo/bai-viet">
                <i class="fa-solid fa-earth-americas"></i>
                <span>Bài viết</span>
            </a>
        </div>

        <hr class="w-100">
    </nav>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>