@model HopTacDoanhNghiep.Areas.Officer.ViewModels.HomeVM.HomeVM
@using HopTacDoanhNghiep.Enums.HoSo
@using HopTacDoanhNghiep.Enums.ViecLam

@{
    ViewData["Title"] = "Trang chủ";
    var keyword = Context.Request.Query["keyword"].ToString();
}

<div class="container">
    <div class="box">
        <div class="box-header mb-4">
            <i class="fa-solid fa-house"></i> Trang chủ
        </div>
        <div class="box-body">
            <section>
                <div class="container">
                    <div class="row">
                        <div class="col-12 col-lg-8 mb-4 mb-lg-0">
                            <h2 class="section-header w-100 mb-3"><a href="/can-bo/thong-tin/tin-tuc"><i class="fa-solid fa-newspaper me-2"></i> Tin tức</h2>
                            <div class="row">
                                <div class="col-12 col-lg-6 mb-3 mb-lg-0">
                                    @if (Model?.TinTucs != null && Model.TinTucs.Any())
                                    {
                                        var latest = Model.TinTucs.First();
                                        <div class="lastest-news">
                                            <div class="thumbnail mb-2">
                                                <img src="@(string.IsNullOrEmpty(latest.AnhMinhHoa) ? "/image/layout/default_noti_thumbnail.jpg" : latest.AnhMinhHoa)" class="w-100" alt="thumbnail" loading="lazy">
                                            </div>
                                            <div>
                                                <div class="title mb-2">
                                                    <a href="/can-bo/thong-tin/tin-tuc/@(latest.Slug ?? "")">@latest.TieuDe</a>
                                                </div>
                                                <div class="meta">
                                                    <div class="meta-item"><i class="fa-solid fa-calendar"></i> @(latest.CreatedAt?.ToString("dd/MM/yyyy"))</div>
                                                    <div class="meta-item highlight"><i class="fa-solid fa-fire"></i> Mới nhất</div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="lastest-news">
                                            <div class="thumbnail mb-2">
                                                <img src="/image/layout/default_noti_thumbnail.jpg" class="w-100" alt="thumbnail" loading="lazy">
                                            </div>
                                            <div>
                                                <div class="title mb-2">
                                                    <a href="#">Chưa có tin tức</a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="col-12 col-lg-6">
                                    <div class="list-news">
                                        @if (Model?.TinTucs != null && Model.TinTucs.Count > 1)
                                        {
                                            foreach (var item in Model.TinTucs.Skip(1).Take(5))
                                            {
                                                <div class="news">
                                                    <div class="row">
                                                        <div class="col-4">
                                                            <div class="thumbnail">
                                                                <img src="@(string.IsNullOrEmpty(item.AnhMinhHoa) ? "/image/layout/default_noti_thumbnail.jpg" : item.AnhMinhHoa)" class="w-100" alt="thumbnail" loading="lazy">
                                                            </div>
                                                        </div>
                                                        <div class="col-8">
                                                            <div>
                                                                <div class="title">
                                                                    <a href="/can-bo/thong-tin/tin-tuc/@(item.Slug ?? "")">@item.TieuDe</a>
                                                                </div>

                                                                <div class="meta">
                                                                    <i class="fa-solid fa-calendar"></i> @(item.CreatedAt?.ToString("dd/MM/yyyy"))
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="news">Chưa có tin tức khác</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <h2 class="section-header w-100 mb-3"><a href="/can-bo/thong-tin/thong-bao"><i class="fa-solid fa-bell me-2"></i> Thông báo</a></h2>
                            <div class="list-notis">
                                @if (Model?.ThongBaos != null && Model.ThongBaos.Any())
                                {
                                    foreach (var noti in Model.ThongBaos.Take(5))
                                    {
                                        <div class="noti">
                                            <div class="row">
                                                <div class="col-4">
                                                    <div class="thumbnail">
                                                        <img src="@(string.IsNullOrEmpty(noti.AnhMinhHoa) ? "/image/layout/default_noti_thumbnail.jpg" : noti.AnhMinhHoa)" class="w-100" alt="thumbnail" loading="lazy">
                                                    </div>
                                                </div>
                                                <div class="col-8">
                                                    <div>
                                                        <div class="title">
                                                            <a href="/can-bo/thong-tin/thong-bao/@(noti.Slug ?? "")">@noti.TieuDe</a>
                                                        </div>
                                                        <div class="meta">
                                                            <i class="fa-solid fa-calendar"></i> @(noti.CreatedAt?.ToString("dd/MM/yyyy"))
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="noti">Chưa có thông báo</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section>
                <div class="container">
                    <h2 class="section-header w-100 mb-3"><a href="/can-bo/bai-viet"><i class="fa-solid fa-earth-americas me-2"></i> Bài viết</a></h2>
                    <div class="swiper posts-slider">
                        <div class="swiper-wrapper">
                            @* Generate remaining 12 posts with swiper-slide wrapper *@
                            @if (Model?.BaiViets != null && Model.BaiViets.Any())
                            {
                                foreach (var post in Model.BaiViets.Take(12))
                                {
                                    <div class="swiper-slide">
                                        <div class="post">
                                            <div class="thumbnail mb-3">
                                                <img src="@(string.IsNullOrEmpty(post.AnhMinhHoa) ? "/image/layout/default_noti_thumbnail.jpg" : post.AnhMinhHoa)" alt="ảnh thumbnail" loading="lazy">
                                            </div>
                                            <div>
                                                <div class="meta mb-2">
                                                    <div class="meta-item"><i class="fa-solid fa-calendar"></i> @(post.CreatedAt?.ToString("dd/MM/yyyy"))</div>
                                                    <div class="meta-item"><i class="fa-solid fa-list"></i> @(post.DanhMuc ?? "")</div>
                                                </div>
                                                <div class="title">
                                                    <a href="/can-bo/bai-viet/@(post.Slug ?? "")">@post.TieuDe</a>
                                                </div>
                                                <div class="summary">
                                                    @Html.Raw(post.NoiDung)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="swiper-slide">
                                    <div class="post">Chưa có bài viết</div>
                                </div>
                            }
                        </div>

                        <!-- Pagination -->
                        <div class="swiper-pagination"></div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

