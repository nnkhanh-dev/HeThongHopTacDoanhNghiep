@model HopTacDoanhNghiep.Areas.Officer.ViewModels.DoanhNghiepVM
@using HopTacDoanhNghiep.Enums.HopTac

@{
    ViewData["Title"] = "Chi tiết đăng ký doanh nghiệp";
}

<div class="container">
    <div class="box">
        <div class="box-header mb-3">
            <i class="fa-solid fa-building"></i> Chi tiết đăng ký doanh nghiệp
        </div>
        <div class="box-body">
            <div class="mb-3">
                <strong>Thông tin doanh nghiệp</strong>
                <div class="content-box">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Tên hiển thị</dt>
                        <dd class="col-sm-9">@Model.TenHienThi</dd>

                        <dt class="col-sm-3">Tên pháp lý</dt>
                        <dd class="col-sm-9">@Model.TenPhapLy</dd>

                        <dt class="col-sm-3">Mã số thuế</dt>
                        <dd class="col-sm-9">@Model.MaSoThue</dd>

                        <dt class="col-sm-3">Website</dt>
                        <dd class="col-sm-9">@Model.Website</dd>

                        <dt class="col-sm-3">Hotline</dt>
                        <dd class="col-sm-9">@Model.Hotline</dd>

                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@Model.EmailCongTy</dd>

                        <dt class="col-sm-3">Trạng thái hợp tác</dt>
                        <dd class="col-sm-9">
                            @switch (Model.TrangThaiHopTac)
                            {
                                case HopTacDoanhNghiepStatus.ChoXuLy:
                                    <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                    break;
                                case HopTacDoanhNghiepStatus.XacNhanDoanhNghiep:
                                    <span class="badge bg-info text-dark">Xác nhận DN</span>
                                    break;
                                case HopTacDoanhNghiepStatus.XacNhanHopTac:
                                    <span class="badge bg-success">Xác nhận hợp tác</span>
                                    break;
                                case HopTacDoanhNghiepStatus.DuyetHopTac:
                                    <span class="badge bg-primary">Duyệt hợp tác</span>
                                    break;
                                case HopTacDoanhNghiepStatus.TuChoi:
                                    <span class="badge bg-danger">Từ chối</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">Không xác định</span>
                                    break;
                            }
                        </dd>

                        <dt class="col-sm-3">Nội dung hợp tác</dt>
                        <dd class="col-sm-9">@Model.NoiDungHopTac</dd>
                    </dl>
                </div>
            </div>

            <div class="mb-3">
                <strong>Thông tin người đại diện</strong>
                <div class="content-box">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Họ tên</dt>
                        <dd class="col-sm-9">@Model.HoTenNguoiDaiDien</dd>

                        <dt class="col-sm-3">Số điện thoại</dt>
                        <dd class="col-sm-9">@Model.SoDienThoaiNguoiDaiDien</dd>
                        
                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@Model.EmailNguoiDaiDien</dd>
                    </dl>
                </div>
            </div>

            <div class="mt-3">
                <a href="/can-bo/doanh-nghiep/dang-ky" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/officer/ChiTietDoanhNghiep.css" />
}