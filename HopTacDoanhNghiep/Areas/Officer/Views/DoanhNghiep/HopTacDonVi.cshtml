@model HopTacDoanhNghiep.ViewModels.Common.PageResult<HopTacDoanhNghiep.Areas.Officer.ViewModels.HopTacDonViVM>
@using HopTacDoanhNghiep.Enums.HopTac

@{
    ViewData["Title"] = "Hợp tác đơn vị";
}

<div class="container">
    <div class="box">
        <div class="box-header mb-4">
            <i class="fa-solid fa-handshake"></i> Hợp tác đơn vị
        </div>
        <div class="box-body">
            @await Html.PartialAsync("_Search")

            <div class="table-responsive mb-3">
                <table class="htdn-table">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Doanh nghiệp</th>
                            <th>Đơn vị</th>
                            <th>Trạng thái</th>
                            <th>Chức năng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Records != null && Model.Records.Any())
                        {
                            var index = (Model.PageIndex - 1) * Model.PageSize;

                            foreach (var item in Model.Records)
                            {
                                index++;
                                <tr>
                                    <td>@index</td>
                                    <td>
                                        <div class="fw-semibold">@(item.TenPhapLy ?? item.TenHienThi)</div>
                                        <div class="text-muted small">@item.MaDN</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@(item.TenDV ?? "-")</div>
                                        <div class="text-muted small">@(!string.IsNullOrWhiteSpace(item.DonViEmail) ? item.DonViEmail : "")</div>
                                    </td>
                                    <td>
                                        @switch (item.TrangThaiHopTac)
                                        {
                                            case HopTacDonViStatus.ChoPhanHoi:
                                                <span class="badge bg-warning text-dark">Chờ phản hồi</span>
                                                break;
                                            case HopTacDonViStatus.HopTac:
                                                <span class="badge bg-success">Hợp tác</span>
                                                break;
                                            case HopTacDonViStatus.KhongHopTac:
                                                <span class="badge bg-danger">Không hợp tác</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">Không xác định</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a href="/can-bo/doanh-nghiep/hop-tac/@item.MaHTDV" class="btn btn-primary" title="Xem chi tiết">
                                            <i class="fa-solid fa-eye"></i> Xem chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">Không có bản ghi</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @await Html.PartialAsync("_Pagination", Model)
        </div>
    </div>
</div>