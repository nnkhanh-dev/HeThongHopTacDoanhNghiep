@model HopTacDoanhNghiep.Areas.Officer.ViewModels.DoanhNghiepVM
@using HopTacDoanhNghiep.Enums.HopTac

@{
    ViewData["Title"] = "Chi tiết doanh nghiệp";
}

<div class="container">
    <div class="box">
        <div class="box-header mb-3">
            <i class="fa-solid fa-building"></i> Chi tiết doanh nghiệp
        </div>
        <div class="box-body">
            <div class="mb-3">
                <strong>Thông tin doanh nghiệp</strong>
                <div class="content-box">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Mã doanh nghiệp</dt>
                        <dd class="col-sm-9">@Model.MaDN</dd>

                        <dt class="col-sm-3">Tên hiển thị</dt>
                        <dd class="col-sm-9">@Model.TenHienThi</dd>

                        <dt class="col-sm-3">Tên pháp lý</dt>
                        <dd class="col-sm-9">@Model.TenPhapLy</dd>

                        <dt class="col-sm-3">Mã số thuế</dt>
                        <dd class="col-sm-9">@Model.MaSoThue</dd>

                        <dt class="col-sm-3">Quy mô nhân sự</dt>
                        <dd class="col-sm-9">@((Model.QuyMoNhanSu.HasValue) ? Model.QuyMoNhanSu.Value.ToString() : "-")</dd>

                        <dt class="col-sm-3">Website</dt>
                        <dd class="col-sm-9">@Model.Website</dd>

                        <dt class="col-sm-3">Hotline</dt>
                        <dd class="col-sm-9">@Model.Hotline</dd>

                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@Model.EmailCongTy</dd>

                        <dt class="col-sm-3">Địa chỉ</dt>
                        <dd class="col-sm-9">@Model.DiaChi</dd>

                        <dt class="col-sm-3">Trạng thái hợp tác</dt>
                        <dd class="col-sm-9">
                            @switch (Model.TrangThaiHopTac)
                            {
                                case HopTacDoanhNghiepStatus.ChoXuLy:
                                    <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                    break;
                                case HopTacDoanhNghiepStatus.XacNhanDoanhNghiep:
                                    <span class="badge bg-info text-dark">Xác nhận DN</span>
                                    break;
                                case HopTacDoanhNghiepStatus.XacNhanHopTac:
                                    <span class="badge bg-success">Xác nhận hợp tác</span>
                                    break;
                                case HopTacDoanhNghiepStatus.DuyetHopTac:
                                    <span class="badge bg-primary">Duyệt hợp tác</span>
                                    break;
                                case HopTacDoanhNghiepStatus.TuChoi:
                                    <span class="badge bg-danger">Từ chối</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">Không xác định</span>
                                    break;
                            }
                        </dd>

                        <dt class="col-sm-3">Nội dung hợp tác</dt>
                        <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.NoiDungHopTac) ? Model.NoiDungHopTac : "-")</dd>

                        <dt class="col-sm-3">Giới thiệu</dt>
                        <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.GioiThieu) ? Model.GioiThieu : "-")</dd>
                    </dl>
                </div>
            </div>

            <div class="mb-3">
                <strong>Chuyển trạng thái</strong>
                <div class="content-box d-flex flex-wrap gap-2 align-items-center">
                    @switch (Model.TrangThaiHopTac)
                    {
                        case HopTacDoanhNghiepStatus.ChoXuLy:
                            <button type="button" class="btn btn-success btn-change-status" data-url="@Url.Action("UpdateTrangThaiHopTac", "DoanhNghiep", new { area = "Officer", MaDN = Model.MaDN })" data-status="@((int)HopTacDoanhNghiepStatus.XacNhanDoanhNghiep)" data-action-text="xác nhận doanh nghiệp">
                                <i class="fa-solid fa-circle-check"></i> Xác nhận doanh nghiệp
                            </button>
                            <button type="button" class="btn btn-danger btn-change-status" data-url="@Url.Action("UpdateTrangThaiHopTac", "DoanhNghiep", new { area = "Officer", MaDN = Model.MaDN })" data-status="@((int)HopTacDoanhNghiepStatus.TuChoi)" data-action-text="từ chối doanh nghiệp">
                                <i class="fa-solid fa-circle-xmark"></i> Từ chối
                            </button>
                            break;
                        case HopTacDoanhNghiepStatus.XacNhanDoanhNghiep:
                            <button type="button" class="btn btn-success btn-change-status" data-url="@Url.Action("UpdateTrangThaiHopTac", "DoanhNghiep", new { area = "Officer", MaDN = Model.MaDN })" data-status="@((int)HopTacDoanhNghiepStatus.XacNhanHopTac)" data-action-text="xác nhận hợp tác">
                                <i class="fa-solid fa-handshake"></i> Xác nhận hợp tác
                            </button>
                            <button type="button" class="btn btn-danger btn-change-status" data-url="@Url.Action("UpdateTrangThaiHopTac", "DoanhNghiep", new { area = "Officer", MaDN = Model.MaDN })" data-status="@((int)HopTacDoanhNghiepStatus.TuChoi)" data-action-text="từ chối hợp tác">
                                <i class="fa-solid fa-circle-xmark"></i> Từ chối
                            </button>
                            break;
                        case HopTacDoanhNghiepStatus.XacNhanHopTac:
                            <button type="button" class="btn btn-primary btn-change-status" data-url="@Url.Action("UpdateTrangThaiHopTac", "DoanhNghiep", new { area = "Officer", MaDN = Model.MaDN })" data-status="@((int)HopTacDoanhNghiepStatus.DuyetHopTac)" data-action-text="duyệt hợp tác">
                                <i class="fa-solid fa-check-double"></i> Duyệt hợp tác
                            </button>
                            <button type="button" class="btn btn-danger btn-change-status" data-url="@Url.Action("UpdateTrangThaiHopTac", "DoanhNghiep", new { area = "Officer", MaDN = Model.MaDN })" data-status="@((int)HopTacDoanhNghiepStatus.TuChoi)" data-action-text="từ chối hợp tác">
                                <i class="fa-solid fa-circle-xmark"></i> Từ chối
                            </button>
                            break;
                        default:
                            <span class="text-muted">Không có hành động khả dụng ở trạng thái hiện tại.</span>
                            break;
                    }
                </div>
            </div>

            <div class="mb-3">
                <strong>Thông tin người đại diện</strong>
                <div class="content-box">
                    <div class="row">
                        <div class="col-md-3 text-center mb-3">
                            @if (!string.IsNullOrEmpty(Model.AnhNguoiDaiDien))
                            {
                                <img src="~/uploads/@Model.AnhNguoiDaiDien" alt="Ảnh đại diện" class="img-fluid img-thumbnail" style="max-width:180px;" />
                            }
                            else
                            {
                                <img src="~/image/default-avatar.png" alt="Ảnh đại diện" class="img-fluid img-thumbnail" style="max-width:180px;" />
                            }
                        </div>
                        <div class="col-md-9">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Họ tên</dt>
                                <dd class="col-sm-8">@Model.HoTenNguoiDaiDien</dd>

                                <dt class="col-sm-4">Số điện thoại</dt>
                                <dd class="col-sm-8">@Model.SoDienThoaiNguoiDaiDien</dd>

                                <dt class="col-sm-4">Email</dt>
                                <dd class="col-sm-8">@Model.EmailNguoiDaiDien</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="mt-3">
                <a href="/can-bo/doanh-nghiep/danh-sach" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/officer/ChiTietDoanhNghiep.css"/>
}

@section Scripts {
    <script src="~/js/officer/DoanhNghiep/ChiTietDangKyDoanhNghiep.js" asp-append-version="true"></script>
}