@model HopTacDoanhNghiep.ViewModels.Common.PageResult<HopTacDoanhNghiep.Areas.Officer.ViewModels.DangKyDoanhNghiepVM>
@using HopTacDoanhNghiep.Enums.HopTac

@{
    ViewData["Title"] = "Đăng ký doanh nghiệp";
}

<div class="container">
    <div class="box">
        <div class="box-header mb-4">
            <i class="fa-solid fa-building"></i> Đăng ký doanh nghiệp
        </div>
        <div class="box-body">
            @await Html.PartialAsync("_Search")
            <div class="table-responsive mb-3">
                <table class="htdn-table">
                    <thead>
                        <tr>
                            <th>Mã DN</th>
                            <th>Tên pháp lý</th>
                            <th>Mã số thuế</th>
                            <th>Trạng thái</th>
                            <th>Chức năng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Records != null && Model.Records.Any())
                        {
                            foreach (var item in Model.Records)
                            {
                                <tr>
                                    <td>@item.MaDN</td>
                                    <td>@(item.TenPhapLy ?? item.TenHienThi)</td>
                                    <td>@item.MaSoThue</td>
                                    <td>
                                        @switch (item.TrangThaiHopTac)
                                        {
                                            case HopTacDoanhNghiepStatus.ChoXuLy:
                                                <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                                break;
                                            case HopTacDoanhNghiepStatus.XacNhanDoanhNghiep:
                                                <span class="badge bg-info text-dark">Xác nhận DN</span>
                                                break;
                                            case HopTacDoanhNghiepStatus.XacNhanHopTac:
                                                <span class="badge bg-success">Xác nhận hợp tác</span>
                                                break;
                                            case HopTacDoanhNghiepStatus.DuyetHopTac:
                                                <span class="badge bg-primary">Duyệt hợp tác</span>
                                                break;
                                            case HopTacDoanhNghiepStatus.TuChoi:
                                                <span class="badge bg-danger">Từ chối</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">Không xác định</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a href="/can-bo/doanh-nghiep/dang-ky/@item.MaDN" class="btn btn-primary" title="Xem chi tiêt"><i class="fa-solid fa-eye"></i> Xem chi tiết</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">Không có bản ghi</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        

            @await Html.PartialAsync("_Pagination", Model)
        </div>
    </div>
</div>
